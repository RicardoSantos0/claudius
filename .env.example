# Copy this file to .env and fill in the key for your selected provider.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI-compatible local endpoints may use this instead of a real OpenAI key.
# MAS_OPENAI_BASE_URL=http://localhost:11434/v1
# Gemini and other gateway routes require the optional LiteLLM dependency.

# Optional overrides
# MAS_GOVERNANCE_MODE=strict
# MAS_MODEL_CATALOG=openai         # anthropic | openai | gemini | custom catalog
# MAS_CODEX_CATALOG=openai
# MAS_OPENCODE_CATALOG=gemini
# MAS_REASONING_MODEL=gpt-5.6-sol
# MAS_STANDARD_MODEL=gpt-5.6-terra
# MAS_ECONOMY_MODEL=gpt-5.6-luna
# MAS_REASONING_PROVIDER=openai
# MAS_STANDARD_PROVIDER=openai
# MAS_ECONOMY_PROVIDER=openai
# Profile-specific PROVIDER and MODEL overrides must always be set together.
# MAS_MASTER_MODEL=claude-fable-5   # legacy fallback
# MAS_DEFAULT_MODEL=claude-sonnet-5 # legacy fallback
# MAS_DATABASE_PROVIDER=sqlite
# MAS_DATABASE_TARGET_PROVIDER=postgresql
# MAS_DATABASE_URL=postgresql://user:password@localhost:5432/mas
# MAS_VECTOR_PROVIDER=chromadb
# MAS_VECTOR_ENABLED=false
# MAS_CHROMA_PATH=mas/data/chromadb
